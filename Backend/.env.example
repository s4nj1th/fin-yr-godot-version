# Copy this file to .env to enable optional LLM-guided mutation. Leave
# LLM_API_KEY blank (or don't create this file at all) and the backend runs
# the core evolutionary loop exactly as designed — archive, minimal
# criterion, surrogate, random mutation — with zero LLM calls.

LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL_NAME=
# auto = use the LLM if a key is set, else random | on = always try LLM | off = ablation control, always random
LLM_MUTATION_MODE=auto

# --- Local model (Ollama) instead of a hosted API ---
# Set LLM_PROVIDER=local and no key is needed. Requires `ollama serve` running
# and the model already pulled, e.g.: ollama pull qwen3.5:4b
#   LLM_PROVIDER=local
#   LLM_MODEL_NAME=qwen3.5:4b
#   LLM_LOCAL_BASE_URL=http://localhost:11434

# --- Evolution settings (defaults shown; see docs/EVOLUTIONARY_DESIGN.md) ---
# Which uncertainty the surrogate gate uses: epistemic (default) | total (v1 behaviour)
#   SURROGATE_GATE_UNCERTAINTY=epistemic
# What to serve while a player's archive is empty: random (default) | default (v1 behaviour)
#   BOOTSTRAP_STRATEGY=random
# Fit the surrogate on only the last N outcomes (0 = all), and draw parents only
# from designs it still predicts passable — for players whose skill changes.
#   SURROGATE_WINDOW=0
#   FILTER_PARENTS_BY_SURROGATE=0
# Fixed dungeon layout (0 = a new random layout every trial). Seed 123 was chosen
# with tools/scan_map_seeds.py; the game's offline default uses the same seed.
#   MAP_SEED=123
# Which genes evolve: full (12 genes, default) | legacy (the original 6)
#   GENOME_SPACE=full
# Surrogate kernel: isotropic (one length scale, default) | ard (one per gene)
#   SURROGATE_KERNEL=isotropic
# Feasibility-biased probing: play an uncertain design only if its predicted
# pass probability is at least this (0 = off; 0.5 was tested in the paper).
#   PLAY_THRESHOLD=0
# Lower bound on challenge: a cleared trial that cost less damage than this
# fails as "too_easy" (0 = off; 100 was tested in the paper).
#   MIN_DAMAGE_TAKEN=0
# Per-archetype criterion: archetypes that cost the player more than this many
# times their average damage per enemy become "nemeses", and designs with more
# than 15% nemeses fail (0 = off; 1.5 was tested in the paper).
#   ARCHETYPE_COST_RATIO=0
# Where player archives, the event log and study data are written (default: Backend/data).
#   EVOLUTION_DATA_DIR=
