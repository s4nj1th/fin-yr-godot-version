; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Evolutionary Dungeon Crawler"
config/description="A Godot 4 C# dungeon crawler driven by a human-coupled evolutionary loop (Minimal Criterion Coevolution) — see docs/EVOLUTIONARY_DESIGN.md."
run/main_scene="res://Scenes/MeleeAiTest.tscn"
config/features=PackedStringArray("4.7", "C#")

[autoload]

GameHud="*res://Scripts/UI/GameHud.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="DungeonCrawler"

[rendering]

textures/canvas_textures/default_texture_filter=0
